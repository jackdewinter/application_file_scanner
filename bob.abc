import argparse
import hashlib
import inspect
import json
import logging
import os
import shutil
import sys
import tempfile
import traceback
from dataclasses import dataclass
from typing import Any, Dict, List, Optional, Tuple

import cookiecutter.exceptions
import cookiecutter.main

LOGGER = logging.getLogger(__name__)


@dataclass(frozen=True)
class CookieSlicerConfiguration:
    config_version: int

    def as_dict(self):
        return {"config_version": self.config_version}

    @staticmethod
    def from_dict(data: Dict[str, Any]) -> "CookieSlicerConfiguration":
        return CookieSlicerConfiguration(
            **{
                key: (
                    data[key]
                    if val.default == val.empty
                    else data.get(key, val.default)
                )
                for key, val in inspect.signature(
                    CookieSlicerConfiguration
                ).parameters.items()
            }
        )

    def __post_init__(self):
        assert self.config_version is not None
        assert type(self.config_version) == int
        assert self.config_version > 0


@dataclass(frozen=True)
class CookieSlicerTemplate:
    slicer_version: int
    slicer_config_version: int
    once: List[str]
    remove: List[str]
    attention: List[str]

    def as_dict(self):
        return {
            "slicer_version": self.slicer_version,
            "slicer_config_version": self.slicer_config_version,
            "once": self.once,
            "attention": self.attention,
            "remove": self.remove,
        }

    @staticmethod
    def from_dict(data: Dict[str, Any]) -> "CookieSlicerTemplate":
        return CookieSlicerTemplate(
            **{
                key: (
                    data[key]
                    if val.default == val.empty
                    else data.get(key, val.default)
                )
                for key, val in inspect.signature(
                    CookieSlicerTemplate
                ).parameters.items()
            }
        )

    def __post_init__(self):
        assert self.slicer_version is not None
        assert type(self.slicer_version) == int
        assert self.slicer_version == 1

        assert self.slicer_config_version is not None
        assert type(self.slicer_config_version) == int
        assert self.slicer_config_version > 0

        assert self.once is not None
        assert type(self.once) == list
        for i in self.once:
            assert i is not None
            assert type(i) == str

        assert self.attention is not None
        assert type(self.attention) == list
        for i in self.attention:
            assert i is not None
            assert type(i) == str

        assert self.remove is not None
        assert type(self.remove) == list
        for i in self.remove:
            assert type(i) == str


class Bob:
    __SLICER_CONFIGURATION_FILE = "cookieslicer.json"

    @staticmethod
    def __validate_directory_existence(input_value: str) -> str:
        if not os.path.isdir(input_value):
            raise argparse.ArgumentTypeError(
                f"Specified directory '{input_value}' does not exist."
            )
        return input_value

    def __parse_arguments(self) -> None:
        parser = argparse.ArgumentParser(description="Lint any found Markdown files.")

        parser.add_argument(
            "--stack-trace",
            dest="show_stack_trace",
            action="store_true",
            default=False,
            help="if an error occurs, print out the stack trace for debug purposes",
        )
        parser.add_argument(
            "-f",
            "--force",
            dest="force_x",
            action="store_true",
            default=False,
            help="help",
        )
        parser.add_argument(
            "-i",
            "--input-directory",
            dest="input_directory",
            action="store",
            required=False,
            help="input",
            type=Bob.__validate_directory_existence,
        )
        parser.add_argument(
            "-s",
            "--source-directory",
            dest="source_directory",
            action="store",
            required=True,
            help="input",
            type=Bob.__validate_directory_existence,
        )
        parser.add_argument(
            "-p",
            "--project-name",
            dest="project_name",
            action="store",
            required=True,
            help="input",
        )

        parser.add_argument(
            "-o",
            "--output-directory",
            dest="output_directory",
            action="store",
            required=True,
            help="output",
            type=Bob.__validate_directory_existence,
        )

        parse_arguments = parser.parse_args()

        self.__show_stack_trace = parse_arguments.show_stack_trace
        self.__input_directory = parse_arguments.input_directory
        if self.__input_directory and not self.__input_directory.endswith(os.sep):
            self.__input_directory += os.sep
        self.__output_directory = parse_arguments.output_directory
        if not self.__output_directory.endswith(os.sep):
            self.__output_directory += os.sep
        self.source_directory = parse_arguments.source_directory
        self.project_name = parse_arguments.project_name
        self.force_x = parse_arguments.force_x

        self.__config_file = os.path.join(
            self.__output_directory, "cookiecutter-config.yaml"
        )

    def __handle_error(
        self, formatted_error: str, thrown_error: Optional[Exception], return_code=1
    ) -> None:
        LOGGER.warning(formatted_error, exc_info=thrown_error)
        stack_trace = "\n" + traceback.format_exc() if self.__show_stack_trace else ""
        print(f"\n\n{formatted_error}{stack_trace}", file=sys.stderr)
        sys.exit(return_code)

    def __load_slicer_template_from_file(self, load_directory):
        input_file_name = os.path.join(load_directory, Bob.__SLICER_CONFIGURATION_FILE)
        with open(input_file_name, "rt", encoding="utf-8") as input_file:
            slicer_template_object = json.load(input_file)
            return CookieSlicerTemplate.from_dict(slicer_template_object)

    def __load_destination_slicer_file_if_present(
        self,
    ) -> Optional[CookieSlicerConfiguration]:
        input_file_name = os.path.join(
            self.__output_directory, Bob.__SLICER_CONFIGURATION_FILE
        )
        if not (os.path.exists(input_file_name) and os.path.isfile(input_file_name)):
            return None
        with open(input_file_name, "rt", encoding="utf-8") as input_file:
            slicer_config_object = json.load(input_file)
            return CookieSlicerConfiguration.from_dict(slicer_config_object)

    def __calculate_file_hash(self, file_path):
        BLOCKSIZE = 65536
        hasher = hashlib.sha256()
        with open(file_path, "rb") as binary_input_file:
            file_buffer = binary_input_file.read(BLOCKSIZE)
            while len(file_buffer) > 0:
                hasher.update(file_buffer)
                file_buffer = binary_input_file.read(BLOCKSIZE)
        return hasher.hexdigest()

    def __process_copy_file(
        self, next_relative_file, next_input_file, next_output_file
    ):
        return self.__copy_file_with_log_message(
            "Encountered unmarked file '%s'. Copying file.",
            next_relative_file,
            next_output_file,
            next_input_file,
        )

    def __process_once_file(
        self, next_relative_file, next_input_file, next_output_file
    ):
        if not os.path.exists(next_output_file):
            return self.__copy_file_with_log_message(
                "Encountered file '%s' marked as once and does not exist at destination. Copying file.",
                next_relative_file,
                next_output_file,
                next_input_file,
            )
        LOGGER.debug(
            "Encountered file '%s' marked as once and already exists at destination.  Skipping file.",
            next_relative_file,
        )
        return False, False

    def __process_attention_file(
        self,
        next_relative_file: str,
        next_input_file: str,
        next_output_file: str,
        attention_files: List[str],
    ) -> Tuple[bool, bool]:
        attention_files.append(next_output_file)
        return self.__copy_file_with_log_message(
            "Encountered file '%s' marked as requiring attention. Copying file.",
            next_relative_file,
            next_output_file,
            next_input_file,
        )

    def __copy_file_with_log_message(
        self,
        log_messsage_format: str,
        next_relative_file: str,
        next_output_file: str,
        next_input_file: str,
    ) -> Tuple[bool, bool]:
        LOGGER.debug(log_messsage_format, next_relative_file)

        output_file_directory = os.path.dirname(next_output_file)
        if not os.path.exists(output_file_directory):
            LOGGER.debug(
                "Destination directory '%s' does not exist.  Creating.",
                output_file_directory,
            )
            os.makedirs(output_file_directory, exist_ok=False)

        do_file_copy = True
        if os.path.exists(next_output_file):
            destination_digest = self.__calculate_file_hash(next_output_file)
            template_digest = self.__calculate_file_hash(next_input_file)
            LOGGER.debug("Template digest: %s", template_digest)
            LOGGER.debug("Destination digest: %s", destination_digest)
            do_file_copy = destination_digest != template_digest

        if do_file_copy:
            LOGGER.debug(
                "Copying template file '%s' to destination file '%s'.",
                next_relative_file,
                next_output_file,
            )
            shutil.copy(next_input_file, next_output_file)
        else:
            LOGGER.debug(
                "Template file '%s' and destination file '%s' equal.  Copy skipped.",
                next_relative_file,
                next_output_file,
            )
        return True, not do_file_copy

    def __process_found_files(
        self,
        file_template: CookieSlicerTemplate,
        next_relative_file: str,
        next_input_file: str,
        next_output_file: str,
        attention_files: List[str],
    ) -> bool:
        # TODO turn off? pre-process?
        if "\\" in next_relative_file:
            next_relative_file = next_relative_file.replace("\\", "/")

        did_copy_file = False
        did_skip_copy = False
        if next_relative_file == Bob.__SLICER_CONFIGURATION_FILE:
            LOGGER.debug(
                "Encountered configuration file '%s'.  Skipping file.",
                next_relative_file,
            )
        elif next_relative_file in file_template.remove:
            LOGGER.debug(
                "Encountered file '%s' marked for removal.  Skipping file.",
                next_relative_file,
            )
        elif next_relative_file in file_template.once:
            did_copy_file, did_skip_copy = self.__process_once_file(
                next_relative_file, next_input_file, next_output_file
            )
        elif next_relative_file in file_template.attention:
            did_copy_file, did_skip_copy = self.__process_attention_file(
                next_relative_file, next_input_file, next_output_file, attention_files
            )
        else:
            did_copy_file, did_skip_copy = self.__process_copy_file(
                next_relative_file, next_input_file, next_output_file
            )
        return did_copy_file, did_skip_copy

    def __process_remove_files(self, file_template: CookieSlicerTemplate):
        num_removed = 0
        for next_relative_file in file_template.remove:
            next_output_file = os.path.join(self.__output_directory, next_relative_file)
            LOGGER.debug(
                "File '%s' marked for removal at destination.",
                next_relative_file,
            )
            if os.path.exists(next_output_file):
                LOGGER.debug(
                    "File '%s' encountered at destination.  Removing.",
                    next_output_file,
                )
                os.remove(next_output_file)
                num_removed += 1

        return num_removed

    def __process_tempalted_files(self, file_template):
        attention_files = []
        number_copied = 0
        number_skipped = 0
        number_blah = 0
        for walk_directory, _, walk_files in os.walk(self.__input_directory):
            for next_file in walk_files:
                next_input_file = os.path.join(walk_directory, next_file)
                next_relative_file = next_input_file[len(self.__input_directory) :]
                next_output_file = os.path.join(
                    self.__output_directory, next_relative_file
                )
                did_copy, did_skip = self.__process_found_files(
                    file_template,
                    next_relative_file,
                    next_input_file,
                    next_output_file,
                    attention_files,
                )
                if did_copy:
                    if did_skip:
                        number_skipped += 1
                    else:
                        number_copied += 1
                else:
                    number_blah += 1

        num_removed = self.__process_remove_files(file_template)
        return attention_files, number_copied, number_skipped, number_blah, num_removed

    def __apply_cookie_cutter(
        self, cookiecutter_source_directory, config_file, nested_directory_name
    ):
        try:
            cookiecutter.main.cookiecutter(
                cookiecutter_source_directory,
                output_dir=self.__input_directory,
                config_file=config_file,
                no_input=True,
                overwrite_if_exists=True,
            )
        except cookiecutter.exceptions.OutputDirExistsException as this_exception:
            self.__handle_error("blah", this_exception)
        except cookiecutter.exceptions.CookiecutterException as this_exception:
            self.__handle_error("General error with cookiecutter.", this_exception)

        self.__input_directory = os.path.join(
            self.__input_directory, nested_directory_name
        )
        if self.__input_directory and not self.__input_directory.endswith(os.sep):
            self.__input_directory += os.sep

    def __check_for_apply_template_permission(self):
        if existing_configuration := self.__load_destination_slicer_file_if_present():
            LOGGER.info(
                "Local cookieslicer configuration loaded with config version %d.",
                existing_configuration.config_version,
            )
        else:
            LOGGER.info("Cookieslicer configuration does not yet exist.")

        project_directory = os.path.join(
            self.source_directory, "{{cookiecutter.project_name}}"
        )
        assert os.path.isdir(project_directory)
        file_template = self.__load_slicer_template_from_file(project_directory)
        LOGGER.info(
            "Templated cookieslicer version is %d.", file_template.slicer_version
        )
        LOGGER.info(
            "Templated cookieslicer configuration version is %d.",
            file_template.slicer_config_version,
        )

        if (
            existing_configuration
            and not self.force_x
            and file_template.slicer_config_version
            == existing_configuration.config_version
        ):
            print(
                f"Cookie slicer destination version '{existing_configuration.config_version}' is equal to the template version."
            )
            print("No templating required.")
            sys.exit(0)

    def __write_cookieslicer_configuration(self):
        updated_configuration = CookieSlicerConfiguration(1)
        output_file_name = os.path.join(self.__output_directory, "cookieslicer.json")
        with open(output_file_name, "wt", encoding="utf-8") as output_file:
            json.dump(updated_configuration.as_dict(), output_file)

    def __apply_templating(self):
        # Apply cookiecutter itself, placing its results into the self.__input_directory
        # directory for examination.
        self.__apply_cookie_cutter(
            self.source_directory, self.__config_file, self.project_name
        )

        file_template = self.__load_slicer_template_from_file(self.__input_directory)

        before_pipfile_hash = None
        output_pipfile_path = os.path.join(self.__output_directory, "Pipfile")
        if os.path.isfile(output_pipfile_path):
            before_pipfile_hash = self.__calculate_file_hash(output_pipfile_path)

        (
            attention_files,
            number_copied,
            number_skipped,
            number_blah,
            num_removed,
        ) = self.__process_tempalted_files(file_template)
        print(f"{attention_files =}")
        print(f"{number_copied =}")
        print(f"{number_skipped =}")
        print(f"{number_blah =}")
        print(f"{num_removed =}")

        self.__write_cookieslicer_configuration()

        if before_pipfile_hash and os.path.isfile(output_pipfile_path):
            after_pipfile_hash = self.__calculate_file_hash(output_pipfile_path)
            if after_pipfile_hash != before_pipfile_hash:
                sys.exit(2)
        sys.exit(0)

    def main(self) -> None:
        """
        Main entrance point.
        """
        logging.basicConfig(stream=sys.stdout, level=logging.ERROR)
        try:
            self.__parse_arguments()
        except ValueError as this_exception:
            formatted_error = f"Configuration Error: {this_exception}"
            self.__handle_error(formatted_error, this_exception)

        # Check to see if the specified version of the template has already been
        # applied.  If so, we can shortcut everything else.
        self.__check_for_apply_template_permission()

        if self.__input_directory:
            self.__apply_templating()
        else:
            with tempfile.TemporaryDirectory() as temporary_directory:
                self.__input_directory = temporary_directory
                self.__apply_templating()


if __name__ == "__main__":
    Bob().main()
